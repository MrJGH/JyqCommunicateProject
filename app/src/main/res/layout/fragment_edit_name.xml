<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_80000000"
        android:focusable="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="@dimen/x400"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_white_corner_10"
            android:focusable="false"
            android:paddingStart="@dimen/x10"
            android:paddingTop="@dimen/x30"
            android:paddingEnd="@dimen/x10"
            android:paddingBottom="@dimen/x20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/user_name_hint_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:gravity="center"
                android:text="@string/user_name"
                android:textColor="@color/color_333333"
                android:textSize="@dimen/x24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.jxw.yuliao.widget.EditTextDeleteView
                android:layout_marginHorizontal="@dimen/x10"
                android:layout_marginTop="@dimen/y24"
                android:id="@+id/edt_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hint="@string/please_input_name"
                app:layout_constraintTop_toBottomOf="@id/user_name_hint_tv" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/cancel_btn"
                android:layout_width="@dimen/x160"
                android:layout_height="@dimen/y50"
                android:layout_marginTop="@dimen/x23"
                android:layout_marginEnd="@dimen/x10"
                android:background="@drawable/shape_gray_corner_25"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/color_333333"
                android:textSize="@dimen/x26"
                app:layout_constraintEnd_toStartOf="@id/guideline"
                app:layout_constraintTop_toBottomOf="@id/edt_name" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/sure_btn"
                android:layout_width="@dimen/x160"
                android:layout_height="@dimen/y50"
                android:layout_marginStart="@dimen/x10"
                android:background="@drawable/shape_blue_corner_25"
                android:gravity="center"
                android:text="@string/sure"
                android:textColor="@color/white"
                android:textSize="@dimen/x26"
                app:layout_constraintBottom_toBottomOf="@id/cancel_btn"
                app:layout_constraintStart_toEndOf="@id/guideline"
                app:layout_constraintTop_toTopOf="@id/cancel_btn" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>