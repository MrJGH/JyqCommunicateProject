<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <FrameLayout
        android:layout_width="@dimen/x260"
        android:layout_height="@dimen/x260">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_qrcode"
            android:layout_width="@dimen/x240"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true" />

        <LinearLayout
            android:id="@+id/ll_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <ProgressBar
                android:layout_width="@dimen/x60"
                android:layout_height="@dimen/x60"
                android:indeterminateBehavior="repeat"
                android:indeterminateDrawable="@drawable/bind_loading"
                android:indeterminateOnly="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/y12"
                android:text="@string/loading"
                android:textColor="@color/white"
                android:textSize="@dimen/x22" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="@dimen/x60"
                android:layout_height="@dimen/x60"
                android:adjustViewBounds="true"
                android:src="@drawable/icon_code_refresh" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/y12"
                android:text="@string/refresh"
                android:textColor="@color/white"
                android:textSize="@dimen/x22" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_no_net"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/ll_link_net"
                android:layout_width="@dimen/x140"
                android:layout_height="@dimen/y50"
                android:background="@drawable/shape_blue_corner_8"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/to_connect_net_work"
                    android:textColor="@color/white"
                    android:textSize="@dimen/x22" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/x20"
                    android:layout_marginLeft="@dimen/x11"
                    android:adjustViewBounds="true"
                    android:src="@drawable/icon_sz_qlw" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/y12"
                android:text="@string/please_connect_network_repeat"
                android:textColor="@color/white"
                android:textSize="@dimen/x22" />


        </LinearLayout>
    </FrameLayout>
</layout>