<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.jxw.yuliao.widget.TitleBarView
        android:id="@+id/main_title_bar_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/y70"
        android:layout_alignParentTop="true"
        app:imageRightVisibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/conversation_title" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_title_bar_2"
        app:layout_constraintVertical_bias="0.0"
        tools:layout_editor_absoluteX="0dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/qrcode_cl"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/color_F3F3F3"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_title_bar_2"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/refresh_iv"
            android:layout_width="@dimen/x40"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/y40"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toStartOf="@id/refresh_hint_tv"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon_code_refresh" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/refresh_hint_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/x19"
            android:text="扫描之后请手动刷新"
            android:textColor="@color/color_333333"
            android:textSize="@dimen/x24"
            app:layout_constraintBottom_toBottomOf="@id/refresh_iv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/refresh_iv"
            app:layout_constraintTop_toTopOf="@id/refresh_iv" />

        <com.jxw.yuliao.widget.QrcodeView
            android:id="@+id/qrcode_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/y20"
            android:adjustViewBounds="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/refresh_iv" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/wechat_bind_hint_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/x25"
            android:layout_marginTop="@dimen/y39"
            android:gravity="center"
            android:text="@string/wechat_scan_qrcode_bind_children_information"
            android:textColor="@color/color_333333"
            android:textSize="@dimen/x24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/qrcode_iv" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.jxw.yuliao.TabRecyclerView
        android:id="@+id/tab_list"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
