<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:gravity="center"

    android:orientation="vertical">

    <TextView
        android:id="@+id/recoder_dialog_label_id"
        android:layout_width="@dimen/y388"
        android:layout_height="@dimen/x56"
        android:background="@drawable/audio_text_bg"
        android:gravity="center"
        android:maxLines="1"
        android:text="松开自动发送，上滑取消发送"
        android:textColor="#222222"
        android:textSize="@dimen/y24" />

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="@dimen/x269"
        android:layout_height="@dimen/x130"
        android:layout_marginTop="@dimen/x10"
        android:layout_marginBottom="@dimen/x57"
        android:background="@drawable/img_yl_frame"
        android:orientation="horizontal">

        <com.tencent.qcloud.tuikit.tuichat.classicui.widget.input.WaveVoiceView
            android:id="@+id/recoder_voice_id"
            android:layout_width="@dimen/x128"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:voiceLineWidth="@dimen/x6" />

        <TextView
            android:id="@+id/send_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#000000"
            android:textSize="@dimen/x26" />

    </FrameLayout>


</LinearLayout>