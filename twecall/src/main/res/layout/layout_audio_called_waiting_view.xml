<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_refuse"
        android:layout_width="@dimen/x80"
        android:layout_height="@dimen/x80"
        app:layout_constraintEnd_toStartOf="@id/iv_answer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_tuicallkit_hangup" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_refuse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x8"
        android:text="@string/voip_refuse"
        android:textColor="@color/white"
        android:textSize="@dimen/x26"
        app:layout_constraintEnd_toEndOf="@id/iv_refuse"
        app:layout_constraintStart_toStartOf="@id/iv_refuse"
        app:layout_constraintTop_toBottomOf="@id/iv_refuse" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_answer"
        android:layout_width="@dimen/x80"
        android:layout_height="@dimen/x80"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_refuse"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/selector_accept_btn" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_answer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x8"
        android:text="@string/voip_accept"
        android:textColor="@color/white"
        android:textSize="@dimen/x26"
        app:layout_constraintEnd_toEndOf="@id/iv_answer"
        app:layout_constraintStart_toStartOf="@id/iv_answer"
        app:layout_constraintTop_toBottomOf="@id/iv_answer" />

</androidx.constraintlayout.widget.ConstraintLayout>