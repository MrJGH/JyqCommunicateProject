<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.jxw.twecall.widget.RoundCornerImageView
        android:id="@+id/iv_header"
        app:corner_radius="@dimen/x50"
        android:layout_width="@dimen/x140"
        android:layout_height="@dimen/x140"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_launcher"
        tools:srcCompat="@drawable/ic_launcher" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x10"
        android:text="爸爸"
        android:textColor="@color/white"
        android:textSize="@dimen/x28"
        app:layout_constraintEnd_toEndOf="@id/iv_header"
        app:layout_constraintStart_toStartOf="@id/iv_header"
        app:layout_constraintTop_toBottomOf="@id/iv_header"
        tools:text="爸爸" />

    <TextView
        android:id="@+id/tv_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/x107"
        android:textColor="@color/white"
        android:textSize="@dimen/x26"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        tools:text="邀请你接受视频通话"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>